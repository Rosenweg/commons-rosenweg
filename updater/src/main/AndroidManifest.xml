<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Rosenweg Updater: Katalog der Anlage lesen, APKs laden, dem Android-Installer uebergeben -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- installierte Rosenweg-Apps sehen (Version, Signatur). Liste = Katalog der Anlage. -->
    <queries>
        <package android:name="ch.rosenweg4303.telefon" />
        <package android:name="ch.rosenweg4303.keyboard" />
        <package android:name="ch.rosenweg4303.home" />
        <package android:name="ch.rosenweg4303.phone" />
        <package android:name="ch.rosenweg4303.contacts" />
        <package android:name="ch.rosenweg4303.gallery" />
        <package android:name="ch.rosenweg4303.camera" />
        <package android:name="ch.rosenweg4303.filemanager" />
        <package android:name="ch.rosenweg4303.calendar" />
        <package android:name="ch.rosenweg4303.clock" />
        <package android:name="ch.rosenweg4303.math" />
        <package android:name="ch.rosenweg4303.notes" />
        <package android:name="ch.rosenweg4303.documents" />
        <package android:name="ch.rosenweg4303.voicerecorder" />
        <package android:name="ch.rosenweg4303.paint" />
        <package android:name="ch.rosenweg4303.messages" />
        <package android:name="ch.rosenweg4303.karten" />
        <!-- seit 0.1.4: Rosenweg Kiosk (Android TV) und die Flutter-Apps (rosenweg_basis) -->
        <package android:name="ch.rosenweg4303.kiosk" />
        <package android:name="ch.rosenweg4303.vm" />
        <package android:name="ch.rosenweg4303.salz" />
        <package android:name="ch.rosenweg4303.profil" />
        <!-- Rosenweg Mein Telefon (Flutter, rosenweg_basis) -->
        <package android:name="ch.rosenweg4303.meintelefon" />
    </queries>

    <application>
        <activity
            android:name="ch.rosenweg4303.updater.UpdateActivity"
            android:exported="false"
            android:label="Rosenweg-Updates"
            android:launchMode="singleTop"
            android:theme="@style/RosenwegUpdater" />
        <receiver
            android:name="ch.rosenweg4303.updater.InstallStatus"
            android:exported="false" />
        <provider
            android:name="ch.rosenweg4303.updater.UpdaterStart"
            android:authorities="${applicationId}.rosenweg.updater"
            android:exported="false" />
    </application>
</manifest>
