<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Nur Apps mit diesem Modul duerfen ins Netz: zur Nextcloud der Person. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- WorkManager wartet auf Netz -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Anmeldeschirm: Rosenweg-Karte (UniFi Access) lesen; Handys ohne NFC bleiben erlaubt -->
    <uses-permission android:name="android.permission.NFC" />
    <uses-feature android:name="android.hardware.nfc" android:required="false" />

    <!-- Zugang der am geteilten Telefon angemeldeten Person von Rosenweg Gerät (nur Rosenweg-Signatur) -->
    <uses-permission android:name="ch.rosenweg4303.permission.ANLAGE" />
    <queries>
        <provider android:authorities="ch.rosenweg4303.telefon.anlage" />
    </queries>

    <application>
        <!-- Rosenweg Geraet fragt vor dem Abmelden, ob noch etwas hochzuladen ist -->
        <provider
            android:name="ch.rosenweg4303.cloud.HochladenStatus"
            android:authorities="${applicationId}.rosenweg.hochladen"
            android:exported="true"
            android:permission="ch.rosenweg4303.permission.ANLAGE" />
        <!-- Ruecksprung der Rosenweg-Anmeldung (Authentik rosenweg-apps): <applicationId>:/anmeldung -->
        <activity
            android:name="ch.rosenweg4303.cloud.RosenwegAnmeldungActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="${applicationId}" android:path="/anmeldung" />
            </intent-filter>
        </activity>
        <!-- Gemeinsamer Anmeldeschirm (privates Handy): Karte oder Rosenweg-Konto, wie der
             Sperrbildschirm der geteilten Telefone -->
        <activity
            android:name="ch.rosenweg4303.cloud.RosenwegAnmeldeSchirm"
            android:exported="false"
            android:label="Anmelden"
            android:screenOrientation="portrait"
            android:launchMode="singleTop"
            android:theme="@android:style/Theme.DeviceDefault.NoActionBar" />
        <activity
            android:name="ch.rosenweg4303.cloud.AnmeldenActivity"
            android:exported="false"
            android:label="Rosenweg-Nextcloud"
            android:launchMode="singleTop"
            android:theme="@style/RosenwegCloud.Anmelden" />
    </application>
</manifest>
